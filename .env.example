# =============================================================================
# NEO BANK OS 2026 — Environment Example
# -----------------------------------------------------------------------------
# This file contains NO real secrets. Copy to `.env` and fill local values.
# This is a SANDBOX prototype — never put real banking credentials here.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# docker-compose provides a local Postgres on port 5432.
DATABASE_URL="postgresql://neobank:neobank@localhost:5432/neobank?schema=public"

# --- App ---------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- Auth / Session ----------------------------------------------------------
# 32+ char random string. Generate locally with: openssl rand -hex 32
# DO NOT reuse this example value in any deployed environment.
SESSION_SECRET="dev-only-change-me-please-32-bytes-minimum-aaaaaaaaaaaaaaaaaaaa"
SESSION_TTL_HOURS="12"

# --- Email OTP (MOCK) --------------------------------------------------------
# When MOCK, OTP codes are logged to the server console instead of being sent.
OTP_PROVIDER="mock"
OTP_TTL_SECONDS="300"

# --- AI Assistant Layer ------------------------------------------------------
# Provider adapter selection. "mock" needs no API key and ships by default.
# Swap to "openai" | "anthropic" | "gemini" once you wire a real adapter.
AI_PROVIDER="mock"
# AI_API_KEY=""          # set only for non-mock providers
# AI_MODEL=""

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"

# --- Sandbox toggles ---------------------------------------------------------
# Seed demo balances. NEVER enable demo seeding logic in a real deployment.
SEED_DEMO_DATA="true"
